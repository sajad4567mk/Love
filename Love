<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffb6d0">
  <meta name="description" content="یه سوال کوچولوی عاشقانه برای تو 💗">

  <title>یه سوال ازت دارم 💗</title>

  <style>
    :root {
      --pink: #ff4384;
      --pink-dark: #e62970;
      --pink-light: #ffd8e7;
      --text: #74264b;
      --glass: rgba(255, 255, 255, .76);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: 24px 16px;
      overflow-x: hidden;
      font-family: Tahoma, Arial, sans-serif;
      color: var(--text);
      background:
        radial-gradient(ellipse at 15% 15%, #fff2f7 0%, transparent 40%),
        radial-gradient(ellipse at 85% 85%, #ff9fc5 0%, transparent 40%),
        linear-gradient(135deg, #ffc4db, #ffe6ef, #ffb4d0);
      background-size: 150% 150%;
      animation: backgroundMove 12s ease-in-out infinite alternate;
    }

    button {
      font: inherit;
      -webkit-tap-highlight-color: transparent;
    }

    .hearts {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }

    .floating-heart {
      position: absolute;
      bottom: -60px;
      opacity: 0;
      animation: floatUp linear infinite;
      filter: drop-shadow(0 3px 8px #ff438433);
      user-select: none;
    }

    .card {
      position: relative;
      z-index: 1;
      width: min(100%, 440px);
      padding: 36px 24px 30px;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, .85);
      border-radius: 32px;
      background: var(--glass);
      box-shadow:
        0 24px 70px rgba(190, 54, 105, .15),
        inset 0 1px 0 rgba(255, 255, 255, .95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      animation: cardEnter .8s cubic-bezier(.2, .8, .2, 1) both;
    }

    .badge {
      display: inline-block;
      padding: 8px 14px;
      margin-bottom: 22px;
      border-radius: 999px;
      color: var(--pink-dark);
      background: #ffe5ef;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: .3px;
    }

    .main-heart {
      display: block;
      font-size: 76px;
      line-height: 1.3;
      margin-bottom: 12px;
      transform-origin: center;
      animation: heartbeat 1.6s ease-in-out infinite;
      filter: drop-shadow(0 10px 14px #ff43842b);
    }

    h1 {
      margin: 0;
      color: #b51d59;
      font-size: clamp(23px, 6vw, 30px);
      line-height: 1.9;
      font-weight: 900;
    }

    .subtitle {
      margin: 10px 0 28px;
      color: #98617b;
      font-size: 14px;
      line-height: 2;
    }

    .button-area {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      min-height: 90px;
      padding: 10px 0;
      flex-wrap: wrap;
    }

    .choice {
      position: relative;
      border: 0;
      border-radius: 18px;
      min-height: 52px;
      padding: 14px 25px;
      font-size: 17px;
      font-weight: bold;
      white-space: nowrap;
      cursor: pointer;
      touch-action: manipulation;
      transition:
        transform .3s cubic-bezier(.2, .8, .2, 1),
        box-shadow .3s ease,
        background .3s ease;
    }

    .choice:focus-visible {
      outline: 3px solid #a81d55;
      outline-offset: 5px;
    }

    .yes {
      color: white;
      background: linear-gradient(135deg, #ff6ba0, #f52c75);
      box-shadow: 0 8px 22px #ff43844d;
      transform: scale(var(--yes-scale, 1));
      transform-origin: center;
      z-index: 2;
    }

    .yes:hover {
      box-shadow: 0 12px 30px #ff438466;
    }

    .no {
      color: #8b6680;
      background: rgba(255, 255, 255, .85);
      border: 1px solid #f4d7e3;
      box-shadow: 0 5px 14px #b51d5910;
      transform: scale(var(--no-scale, 1));
      transform-origin: center;
    }

    .hint {
      margin-top: 20px;
      min-height: 28px;
      color: #ad6b89;
      font-size: 13px;
      line-height: 1.9;
    }

    .result {
      display: none;
      animation: resultEnter .7s cubic-bezier(.2, .8, .2, 1) both;
    }

    .result.show {
      display: block;
    }

    .result-emoji {
      font-size: 65px;
      margin: 10px 0;
      animation: heartbeat 1s infinite;
    }

    .result h2 {
      color: #d8216b;
      font-size: 27px;
      line-height: 1.8;
      margin: 10px 0;
    }

    .result p {
      line-height: 2.2;
      font-size: 15px;
      color: #88516e;
    }

    .restart {
      border: 1px solid #f3c3d6;
      border-radius: 13px;
      background: white;
      color: #ad2860;
      padding: 11px 18px;
      margin-top: 12px;
      cursor: pointer;
    }

    .footer {
      margin-top: 28px;
      color: #b47b96;
      font-size: 11px;
    }

    .confetti {
      position: fixed;
      top: -25px;
      z-index: 10;
      pointer-events: none;
      animation: confettiFall linear forwards;
    }

    .hidden {
      display: none !important;
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.09); }
    }

    @keyframes backgroundMove {
      from { background-position: 0% 0%; }
      to { background-position: 100% 100%; }
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) rotate(0deg);
        opacity: 0;
      }
      10% { opacity: .65; }
      90% { opacity: .5; }
      100% {
        transform: translateY(-115vh) rotate(35deg);
        opacity: 0;
      }
    }

    @keyframes cardEnter {
      from {
        opacity: 0;
        transform: translateY(24px) scale(.96);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes resultEnter {
      from {
        opacity: 0;
        transform: translateY(15px) scale(.94);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes confettiFall {
      to {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
      }
    }

    @media (max-width: 380px) {
      .card {
        padding: 28px 16px;
      }

      .button-area {
        gap: 12px;
      }

      .choice {
        padding: 12px 18px;
        font-size: 15px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <div class="hearts" id="hearts" aria-hidden="true"></div>

  <main class="card">
    <div id="proposal">
      <div class="badge">💌 یه سوال مخصوص تو</div>

      <span class="main-heart" aria-hidden="true">💗</span>

      <h1 id="question">خشگله، رلم میشی؟ 🥹❤️</h1>

      <p class="subtitle">
        یه سوال کوچولو دارم ازت...
        <br>
        جوابش برام خیلی قشنگه 💕
      </p>

      <div class="button-area">
        <button class="choice yes" id="yes" type="button">
          آره 😍
        </button>

        <button class="choice no" id="no" type="button">
          نه 🙃
        </button>
      </div>

      <div class="hint" id="hint" aria-live="polite">
        با دلت جواب بده 💗
      </div>
    </div>

    <section class="result" id="result" aria-live="polite">
      <div class="result-emoji">🥹💖</div>
      <h2>یوهووووو! 😭💕</h2>
      <p>
        مرسی که جواب دادی! 🫶🏻
        <br>
        امیدوارم کلی لحظه قشنگ کنار هم بسازیم.
        <br>
        💗🌷💗
      </p>

      <button class="restart" id="restart" type="button">
        دوباره ببینیم؟ 💌
      </button>
    </section>

    <div class="footer">made with love ♡</div>
  </main>

  <script>
    (() => {
      "use strict";

      const yesButton = document.getElementById("yes");
      const noButton = document.getElementById("no");
      const question = document.getElementById("question");
      const hint = document.getElementById("hint");
      const proposal = document.getElementById("proposal");
      const result = document.getElementById("result");
      const restartButton = document.getElementById("restart");
      const heartsContainer = document.getElementById("hearts");

      let noClicks = 0;
      let yesScale = 1;
      let noScale = 1;
      let finished = false;
      let confettiTimers = [];

      const noMessages = [
        "مطمئنی؟ 🥺💗",
        "یه بار دیگه فکر کن! 🌷",
        "آخه چرااا؟ 😭💕",
        "یه آره کوچولو چی می‌شه؟ 🥹",
        "هنوزم فرصت داری نظرتو عوض کنی! 💖",
        "خب، هر جوابی بدی قابل احترامه ❤️"
      ];

      // Create a limited number of decorative hearts.
      const heartSymbols = ["💗", "💕", "♡", "💖", "🌸"];

      for (let i = 0; i < 15; i++) {
        const heart = document.createElement("span");

        heart.className = "floating-heart";
        heart.textContent =
          heartSymbols[Math.floor(Math.random() * heartSymbols.length)];

        heart.style.left = Math.random() * 100 + "%";
        heart.style.fontSize = (14 + Math.random() * 18) + "px";
        heart.style.animationDuration = (9 + Math.random() * 12) + "s";
        heart.style.animationDelay = (-Math.random() * 15) + "s";

        heartsContainer.appendChild(heart);
      }

      function updateButtons() {
        yesButton.style.setProperty("--yes-scale", yesScale);
        noButton.style.setProperty("--no-scale", noScale);
      }

      function sayNo() {
        if (finished) return;

        noClicks++;

        // Keep button scaling within safe limits.
        yesScale = Math.min(yesScale + 0.16, 2.1);
        noScale = Math.max(noScale - 0.10, 0.55);

        updateButtons();

        const messageIndex = Math.min(
          noClicks - 1,
          noMessages.length - 1
        );

        question.textContent = noMessages[messageIndex];

        hint.textContent = noClicks >= 5
          ? "هر جوابی بدی، انتخابت محترمه 💗"
          : "مطمئنی که نمی‌خوای؟ 🥹";
      }

      function makeConfetti() {
        const symbols = ["💗", "💕", "💖", "🌸", "✨"];
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        if (reducedMotion) return;

        // Limit the total number of particles.
        for (let i = 0; i < 35; i++) {
          const piece = document.createElement("span");

          piece.className = "confetti";
          piece.textContent =
            symbols[Math.floor(Math.random() * symbols.length)];

          piece.style.left = Math.random() * 100 + "vw";
          piece.style.fontSize = (14 + Math.random() * 15) + "px";
          piece.style.animationDuration = (2 + Math.random() * 2) + "s";
          piece.style.animationDelay = (Math.random() * 0.8) + "s";

          document.body.appendChild(piece);

          const timer = setTimeout(() => {
            piece.remove();
          }, 5000);

          confettiTimers.push(timer);
        }
      }

      function sayYes() {
        if (finished) return;

        finished = true;

        proposal.classList.add("hidden");
        result.classList.add("show");

        makeConfetti();
      }

      function restart() {
        confettiTimers.forEach(clearTimeout);
        confettiTimers = [];

        document.querySelectorAll(".confetti").forEach(
          element => element.remove()
        );

        finished = false;
        noClicks = 0;
        yesScale = 1;
        noScale = 1;

        updateButtons();

        question.textContent = "خشگله، رلم میشی؟ 🥹❤️";
        hint.textContent = "با دلت جواب بده 💗";

        result.classList.remove("show");
        proposal.classList.remove("hidden");
      }

      noButton.addEventListener("click", sayNo);
      yesButton.addEventListener("click", sayYes);
      restartButton.addEventListener("click", restart);
    })();
  </script>
</body>
</html>
